generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartnerType {
  agency
  operator
  travel_advisor
  media
  other
}

enum RelationshipStatus {
  not_contacted
  contacted
  awaiting_reply
  engaged
  visit_scheduled
  visited
  proposal_sent
  active_partner
  inactive
  not_interested
}

enum VisitStatus {
  never_invited
  invited
  scheduled
  visited
}

enum OutreachChannel {
  email
  whatsapp
  phone
  meeting
  other
}

enum TouchDirection {
  outbound
  inbound
}

enum MailboxProvider {
  gmail
}

enum EmailDirection {
  outbound
  inbound
}

enum EmailMatchSource {
  thread_id
  participant_email
  manual
}

enum TaskStatus {
  open
  done
  cancelled
}

enum ResearchSourceType {
  instagram
  website
  directory
  manual
  referral
  other
}

enum ResearchFindingStatus {
  new
  reviewed
  promoted
  discarded
  merged
}

model PartnerOrganization {
  id              String             @id @default(cuid())
  propertyId      String
  name            String
  type            PartnerType        @default(agency)
  country         String?
  city            String?
  website         String?
  whatsapp        String?
  phone           String?
  email           String?
  source          String?
  marketNotes     String?
  ownerUserId     String?
  ownerUserName   String?
  priority        Int                @default(0)
  status          RelationshipStatus @default(not_contacted)
  visitStatus     VisitStatus        @default(never_invited)
  lastVisitedAt   DateTime?
  visitNotes      String?
  lastContactedAt DateTime?
  nextActionAt    DateTime?
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contacts        PartnerContact[]
  touches         OutreachTouch[]
  tasks           FollowUpTask[]
  notes           Note[]
  tags            TagOnContact[]
  researchFindings ResearchFinding[]
  emailThreads    EmailThread[]
  emailMessages   EmailMessage[]

  @@index([propertyId, status])
  @@index([propertyId, visitStatus])
  @@index([propertyId, nextActionAt])
  @@index([propertyId, archivedAt])
}

model Note {
  id             String              @id @default(cuid())
  organizationId String
  text           String
  author         String              @default("Dennis")
  createdAt      DateTime            @default(now())
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Tag {
  id       String         @id @default(cuid())
  name     String         @unique
  contacts TagOnContact[]
}

model TagOnContact {
  organizationId String
  tagId          String
  organization   PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tag            Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([organizationId, tagId])
  @@index([tagId])
}

model EmailTemplate {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  subject    String
  body       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId, sortOrder])
}

model ResearchFinding {
  id                  String                @id @default(cuid())
  propertyId          String
  sourceType          ResearchSourceType    @default(manual)
  sourceUrl           String?
  sourceHandle        String?
  observedName        String?
  observedText        String?
  extractedDataJson   Json?
  confidence          Float?
  status              ResearchFindingStatus @default(new)
  proposedOrganizationId String?
  createdByActorType  String
  createdByActorId    String
  createdByActorLabel String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  proposedOrganization PartnerOrganization? @relation(fields: [proposedOrganizationId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, createdAt])
  @@index([propertyId, sourceType])
  @@index([proposedOrganizationId])
}

model PartnerContact {
  id              String              @id @default(cuid())
  organizationId  String
  fullName        String
  roleTitle       String?
  email           String?
  phone           String?
  whatsapp        String?
  preferredChannel OutreachChannel?
  isPrimary       Boolean             @default(false)
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  touches         OutreachTouch[]
  tasks           FollowUpTask[]
  emailThreads    EmailThread[]
  emailMessages   EmailMessage[]

  @@index([organizationId])
}

model MailboxConnection {
  id                   String          @id @default(cuid())
  propertyId           String          @unique
  provider             MailboxProvider @default(gmail)
  emailAddress         String
  displayName          String?
  refreshTokenEncrypted String
  scope                String?
  historyId            String?
  labelId              String?
  labelName            String?
  lastSyncedAt         DateTime?
  lastSyncError        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  emailThreads         EmailThread[]
  emailMessages        EmailMessage[]

  @@index([propertyId, provider])
}

model EmailThread {
  id                  String              @id @default(cuid())
  mailboxConnectionId String
  organizationId      String
  contactId           String?
  providerThreadId    String
  subject             String?
  snippet             String?
  participantEmails   Json?
  lastMessageAt       DateTime
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  mailboxConnection   MailboxConnection   @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)
  organization        PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             PartnerContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages            EmailMessage[]

  @@unique([mailboxConnectionId, providerThreadId])
  @@index([organizationId, lastMessageAt])
  @@index([contactId, lastMessageAt])
}

model EmailMessage {
  id                  String              @id @default(cuid())
  mailboxConnectionId String
  emailThreadId       String
  organizationId      String
  contactId           String?
  providerMessageId   String
  internetMessageId   String?
  direction           EmailDirection
  subject             String?
  snippet             String?
  bodyText            String
  bodyHtml            String?
  fromEmail           String?
  fromName            String?
  toEmails            Json?
  ccEmails            Json?
  sentAt              DateTime
  syncedAt            DateTime            @default(now())
  matchSource         EmailMatchSource?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  mailboxConnection   MailboxConnection   @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)
  emailThread         EmailThread         @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  organization        PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             PartnerContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([mailboxConnectionId, providerMessageId])
  @@index([organizationId, sentAt])
  @@index([contactId, sentAt])
  @@index([emailThreadId, sentAt])
}

model OutreachTouch {
  id                String              @id @default(cuid())
  organizationId    String
  contactId         String?
  channel           OutreachChannel
  direction         TouchDirection      @default(outbound)
  happenedAt        DateTime
  subject           String?
  summary           String
  outcome           String?
  nextStep          String?
  createdByUserId   String
  createdByUserName String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact           PartnerContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, happenedAt])
  @@index([contactId])
}

model FollowUpTask {
  id                 String              @id @default(cuid())
  organizationId     String
  contactId          String?
  title              String
  description        String?
  dueAt              DateTime
  status             TaskStatus          @default(open)
  assignedToUserId   String?
  assignedToUserName String?
  createdByUserId    String
  createdByUserName  String
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       PartnerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            PartnerContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueAt])
  @@index([status, dueAt])
}

model ToolActionAudit {
  id               String   @id @default(uuid())
  app              String   @default("partners")
  toolName         String   @map("tool_name")
  classification   String
  actorType        String   @map("actor_type")
  actorId          String?  @map("actor_id")
  actorLabel       String?  @map("actor_label")
  credentialId     String?  @map("credential_id")
  requestSource    String?  @map("request_source")
  propertyId       String?  @map("property_id")
  targetEntityType String?  @map("target_entity_type")
  targetEntityId   String?  @map("target_entity_id")
  status           String
  errorCode        String?  @map("error_code")
  correlationId    String?  @map("correlation_id")
  inputSummary     String?  @map("input_summary")
  outputSummary    String?  @map("output_summary")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([toolName, createdAt])
  @@index([actorType, createdAt])
  @@index([propertyId, createdAt])
  @@map("tool_action_audits")
}
